<?xml version="1.0" encoding="utf-8"?>

<!-- Data file for 'Test Stadt' SpDrS60 Stellwerk -->

<!--
    A Stellbereich contains a part of a broader railway network, managed
    by one SpDrS60 Stellwerk
-->
<Stellbereich>
    <!-- General information about the Stellbereich. -->
    <Configuration>
        <Name>Teststadt</Name>
    </Configuration>

    <!-- Topology graph, as a base for everything. -->
    <Topology>
        <Nodes>
            <Node Type="Boundary" Name="Bleft"/>
            <Node Type="AxleCounter" Name="AC1"/>
            <Node Type="AxleCounter" Name="AC2"/>
            <Node Type="AxleCounter" Name="AC3"/>
            <Node Type="AxleCounter" Name="AC4"/>
            <Node Type="AxleCounter" Name="AC7"/>
            <Node Type="AxleCounter" Name="AC8"/>
            <Node Type="AxleCounter" Name="AC9"/>
            <Node Type="AxleCounter" Name="AC10"/>
            <Node Type="Signal" Name="S1"/>
            <Node Type="Signal" Name="S2"/>
            <Node Type="Signal" Name="S3"/>
            <Node Type="Signal" Name="S4"/>
            <Node Type="Signal" Name="S5"/>
            <Node Type="Signal" Name="S6"/>
            <Node Type="SimpleSwitch" Name="W1"/>
            <Node Type="SimpleSwitch" Name="W2"/>
            <Node Type="Boundary" Name="Bright"/>
        </Nodes>
        <Edges>
            <!-- Left boundary -->
            <Edge Type="Track" Name="T1p" Length="0.5" MaximumSpeed="80">
                <From Port="Center">Bleft</From>
                <To Port="Back">AC1</To>
            </Edge>
            <Edge Type="Track" Name="T1" Length="150.0" MaximumSpeed="80">
                <From Port="Front">AC1</From>
                <To Port="Back">S1</To>
            </Edge>

            <Edge Type="Track" Name="T2" Length="50.0" MaximumSpeed="80">
                <From Port="Front">S1</From>
                <To Port="Back">AC2</To>
            </Edge>

            <Edge Type="Track" Name="T2n" Length="0.5" MaximumSpeed="80">
                <From Port="Front">AC2</From>
                <To Port="Wurzel">W1</To>
            </Edge>

            <!-- Top branch -->
            <Edge Type="Track" Name="T3p" Length="0.5" MaximumSpeed="80">
                <From Port="Gerade">W1</From>
                <To Port="Back">AC3</To>
            </Edge>

            <Edge Type="Track" Name="T3" Length="50.0" MaximumSpeed="80">
                <From Port="Front">AC3</From>
                <To Port="Front">S2</To>
            </Edge>

            <Edge Type="Track" Name="T4" Length="100.0" MaximumSpeed="80">
                <From Port="Back">S2</From>
                <To Port="Back">S4</To>
            </Edge>
            <Edge Type="Track" Name="T5" Length="50.0" MaximumSpeed="80">
                <From Port="Front">S4</From>
                <To Port="Back">AC8</To>
            </Edge>

            <Edge Type="Track" Name="T5n" Length="0.5" MaximumSpeed="80">
                <From Port="Front">AC8</From>
                <To Port="Gerade">W2</To>
            </Edge>

            <!-- Bottom branch -->
            <Edge Type="Track" Name="T6p" Length="0.5" MaximumSpeed="80">
                <From Port="Abzweig">W1</From>
                <To Port="Back">AC4</To>
            </Edge>

            <Edge Type="Track" Name="T6" Length="50.0" MaximumSpeed="80">
                <From Port="Front">AC4</From>
                <To Port="Front">S3</To>
            </Edge>
            <Edge Type="Track" Name="T7" Length="100.0" MaximumSpeed="80">
                <From Port="Back">S3</From>
                <To Port="Back">S5</To>
            </Edge>
            <Edge Type="Track" Name="T8" Length="50.0" MaximumSpeed="80">
                <From Port="Front">S5</From>
                <To Port="Back">AC7</To>
            </Edge>

            <Edge Type="Track" Name="T8n" Length="0.5" MaximumSpeed="80">
                <From Port="Front">AC7</From>
                <To Port="Abzweig">W2</To>
            </Edge>

            <!-- Right boundary -->
            <Edge Type="Track" Name="T9p" Length="0.5" MaximumSpeed="80">
                <From Port="Wurzel">W2</From>
                <To Port="Back">AC9</To>
            </Edge>
            <Edge Type="Track" Name="T9" Length="150.0" MaximumSpeed="80">
                <From Port="Front">AC9</From>
                <To Port="Front">S6</To>
            </Edge>
            <Edge Type="Track" Name="T10" Length="50.0" MaximumSpeed="80">
                <From Port="Back">S6</From>
                <To Port="Back">AC10</To>
            </Edge>
            <Edge Type="Track" Name="T10n" Length="0.5" MaximumSpeed="80">
                <From Port="Front">AC10</From>
                <To Port="Center">Bright</To>
            </Edge>
        </Edges>
    </Topology>

    <!-- Elements of the interlocking system, based on the topology graph. -->
    <Interlocking>
        <TrackSections>
            <!-- A section containing a track, so it has two axle counters -->
            <TrackSection Name="TS1">
                <AxleCounterLink AxleCounter="AC1" Facing="Inward"/>
                <AxleCounterLink AxleCounter="AC2" Facing="Outward"/>
            </TrackSection>

            <!-- A section spanning a switch, so it has three axle counters -->
            <TrackSection Name="TS2">
                <AxleCounterLink AxleCounter="AC2" Facing="Inward"/>
                <AxleCounterLink AxleCounter="AC3" Facing="Outward"/>
                <AxleCounterLink AxleCounter="AC4" Facing="Outward"/>
            </TrackSection>

            <TrackSection Name="TS3">
                <AxleCounterLink AxleCounter="AC3" Facing="Inward"/>
                <AxleCounterLink AxleCounter="AC8" Facing="Outward"/>
            </TrackSection>

            <TrackSection Name="TS4">
                <AxleCounterLink AxleCounter="AC4" Facing="Inward"/>
                <AxleCounterLink AxleCounter="AC7" Facing="Outward"/>
            </TrackSection>

            <TrackSection Name="TS5">
                <AxleCounterLink AxleCounter="AC8" Facing="Inward"/>
                <AxleCounterLink AxleCounter="AC7" Facing="Inward"/>
                <AxleCounterLink AxleCounter="AC9" Facing="Outward"/>
            </TrackSection>

            <TrackSection Name="TS6">
                <AxleCounterLink AxleCounter="AC9" Facing="Inward"/>
                <AxleCounterLink AxleCounter="AC10" Facing="Outward"/>
            </TrackSection>
        </TrackSections>

        <Switches>
            <!-- A simple, two way switch that references switch node W1
                 in the topology graph. Note that switches do not need
                 to know their track section! That's a detail only
                 the tile needs to know, since occupancy state is essentially
                 an overlay over the route state the switch reports.
            -->
            <Switch Name="W1" Reference="W1"/>

            <Switch Name="W2" Reference="W2"/>
        </Switches>

        <SignalMasts>
            <SignalMast Name="S1" Reference="S1">
                <HauptsignalSchirm/>
                <VorsignalSchirm/>
            </SignalMast>

            <SignalMast Name="S2" Reference="S2">
                <HauptsignalSchirm/>
            </SignalMast>

            <SignalMast Name="S3" Reference="S3">
                <HauptsignalSchirm/>
            </SignalMast>

            <SignalMast Name="S4" Reference="S4">
                <HauptsignalSchirm/>
            </SignalMast>

            <SignalMast Name="S5" Reference="S5">
                <HauptsignalSchirm/>
            </SignalMast>

            <SignalMast Name="S6" Reference="S6">
                <HauptsignalSchirm/>
                <VorsignalSchirm/>
            </SignalMast>
        </SignalMasts>

        <Elements>
            <Element type="SignalMast">
                <Hauptsignal></Hauptsignal>
            </Element>
        </Elements>
    </Interlocking>

    <!-- Description of the SpDrS60 Stelltisch controlling the Stellbereich. -->
    <SpDr>
        <Stelltisch Width="10" Height="4">
            <Tiles>
                <Tile X="0" Y="0">
                    <Layers>
                        <Layer Type="TrackIndicator" Geometry="Horizontal" TrackSection="TS1"/>
                    </Layers>
                </Tile>
                <Tile X="1" Y="0">
                    <Layers>
                        <Layer Type="TrackIndicator" Geometry="Horizontal" TrackSection="TS1"/>
                        <Layer Type="HpSignal" Orientation="Forward" SignalMast="S1"/>
                    </Layers>
            </Tiles>
        </Stelltisch>
    </SpDr>

    <!--
        Configuration of the CanLink physical Stelltisch driver. Contains mapping of
        abstract tile feature aperture ids and button ids to and from hardware lamp positions
        and button locations.
    -->
    <CanLink>
        <Tiles>
            <Tile x="0" y="2">
                <!-- Mapping of logical apertures to actual lamps. An aperture might use multiple lamps! -->
                <Apertures>
                    <Aperture id="sighp0" lamps="0"/>
                    <Aperture id="sighp1" lamps="1"/>
                    <Aperture id="siglock" lamps="3"/>
                </Apertures>

                <!-- Mapping of logical buttons to hardware button indices. -->
                <Buttons>
                    <!-- Signaltaste on the tile -->
                    <Button id="sigt" buttonidx="2"/>
                </Buttons>
            </Tile>
        </Tiles>
    </CanLink>
</Stellbereich>